import sys,subprocess,json
from pathlib import Path
sys.path.insert(0,'helpers')
from direct_sympy_strings import syntax
from direct_sympy_conversions_test import cpp
actual=json.loads(Path('docs/evidence/direct-sympy-lazy-synchronization-actual.json').read_text())[-1]
before=Path('docs/evidence/direct-sympy-record-cache-frontier/objects')/(actual['originalDigest']+'.expr')
after=Path(actual['output'])
root=Path('/private/tmp/llm-inner-sync-lazy-native');root.mkdir(exist_ok=True)
source=root/'parity.cpp';binary=root/'parity'
source.write_text('''#include <cstdint>
#include <cstring>
#include <cmath>
#include <cstdio>
template<class T,class U>T word(U value){T result;std::memcpy(&result,&value,sizeof(result));return result;}
'''+ 'double before(double X1,double X2){return '+cpp(syntax(before.read_text()))+';}\n'+ 'double after(double X1,double X2){return '+cpp(syntax(after.read_text()))+';}\n'+'''int main(){unsigned cases=0,mismatches=0;uint32_t state=123456789;for(unsigned bits=0;bits<65536;bits++){double x=word<_Float16>(uint16_t(bits));if(!std::isfinite(x))continue;for(unsigned lane=0;lane<4;lane++){state=state*1664525u+1013904223u;uint16_t b=state>>16;if((b&0x7c00)==0x7c00)b&=0x83ff;double y=lane==0?0.0:lane==1?-0.0:word<_Float16>(b);auto a=word<uint64_t>(before(x,y)),z=word<uint64_t>(after(x,y));mismatches+=a!=z;cases++;}}std::printf("Actual residual synchronized native parity: cases=%u mismatches=%u\\n",cases,mismatches);return mismatches?1:0;}
''')
print('Generated bytes',source.stat().st_size,flush=True)
p=subprocess.run(['clang++','-O1','-ffp-contract=off','-fbracket-depth=8192','-std=c++17',str(source),'-o',str(binary)],capture_output=True,text=True,timeout=180)
if p.returncode:print(p.stderr);raise SystemExit(p.returncode)
p=subprocess.run([str(binary)],capture_output=True,text=True,timeout=120);print(p.stdout,end='');print(p.stderr,end='');raise SystemExit(p.returncode)
