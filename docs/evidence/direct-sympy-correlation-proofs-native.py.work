import sys,subprocess,tempfile
from pathlib import Path
sys.path.insert(0,'helpers')
from direct_sympy_checkpoint import CheckpointStrings
from direct_sympy_strings import StringCompiler,syntax
from direct_sympy_conversions_test import cpp
with CheckpointStrings('docs/evidence/direct-sympy-test-checkpoint',StringCompiler()) as model:
 expression=model.norm('probe','model.layers.0.input_layernorm.weight',0,lambda i:f'X{i+1}')
 assert 'R16(' not in expression and 'R32(' not in expression
 Path('/private/tmp/llm-inner-proof-normalization.work.expr').write_text(expression+'\n')
with tempfile.TemporaryDirectory() as directory:
 source=Path(directory)/'norm.cpp';binary=Path(directory)/'norm'
 source.write_text('''#include <cstdint>
#include <cstring>
#include <cmath>
#include <cstdio>
#include <initializer_list>
template<class T,class U>T word(U value){T result;std::memcpy(&result,&value,sizeof(result));return result;}
'''+ 'double compiled(double X1,double X2){return '+cpp(syntax(expression))+';}\n'+'''double reference(double x,double y){float a=float(x*x),b=float(y*y);float sum=a+b;float mean=sum/2.0f;float v=mean+1e-6f;float root=float(std::sqrt(double(v)));float inverse=1.0f/root;float normalized=float(x*inverse);return static_cast<_Float16>(normalized);}
int main(){unsigned cases=0,mismatches=0;for(unsigned bits=0;bits<65536;bits++){if((bits&0x7c00)==0x7c00)continue;double x=word<_Float16>(uint16_t(bits));for(uint16_t b:{uint16_t(0),uint16_t(0x8000),uint16_t(1),uint16_t(0x8001),uint16_t(0x3c00),uint16_t(0xbc00),uint16_t(0x7bff),uint16_t(0xfbff)}){double y=word<_Float16>(b);mismatches+=word<uint64_t>(compiled(x,y))!=word<uint64_t>(reference(x,y));cases++;}}std::printf("Restored RMS numeric closure: cases=%u mismatches=%u\\n",cases,mismatches);return mismatches?1:0;}
''')
 p=subprocess.run(['clang++','-O3','-ffp-contract=off','-std=c++17',str(source),'-o',str(binary)],capture_output=True,text=True);assert p.returncode==0,p.stderr
 p=subprocess.run([str(binary)],capture_output=True,text=True,timeout=120);print(p.stdout,end='');print(p.stderr,end='');raise SystemExit(p.returncode)
