{
  "name": "model-decompiler-v2",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test dist/test/*.test.js scripts/*.test.mjs",
    "compile:model": "node dist/src/cli.js",
    "compare:trace": "node dist/src/trace-cli.js",
    "compare:generation-trace": "node dist/src/generation-trace-cli.js",
    "capture:mlx-trace": "node dist/src/mlx-trace-capture-cli.js",
    "capture:transformers-trace": "node dist/src/transformers-trace-capture-cli.js",
    "capture:gemma4-text-trace": "npm run build && node dist/src/gemma4-transformers-text-trace-cli.js",
    "capture:gemma4-operation-checkpoints": "npm run build && node dist/src/gemma4-transformers-operation-trace-cli.js",
    "capture:gemma4-audio-checkpoints": "npm run build && node dist/src/gemma4-transformers-audio-trace-cli.js",
    "capture:gemma4-vision-checkpoints": "npm run build && node dist/src/gemma4-transformers-vision-trace-cli.js",
    "capture:gemma4-composite-trace": "npm run build && node dist/src/gemma4-transformers-composite-trace-cli.js",
    "capture:gemma4-linear-reduction": "npm run build && node dist/src/gemma4-transformers-linear-reduction-trace-cli.js",
    "compare:gemma4-paged-text-trace": "npm run build && node dist/src/gemma4-paged-text-differential-cli.js",
    "compare:gemma4-paged-operation-checkpoints": "npm run build && node dist/src/gemma4-paged-text-operation-differential-cli.js",
    "compare:gemma4-literal-audio": "npm run build && node dist/src/gemma4-literal-audio-differential-cli.js",
    "compare:gemma4-literal-vision": "npm run build && node dist/src/gemma4-literal-vision-differential-cli.js",
    "compare:gemma4-literal-composite": "npm run build && node dist/src/gemma4-literal-composite-differential-cli.js",
    "compare:gemma4-literal-composite-suite": "npm run build && node dist/src/gemma4-literal-composite-modality-suite-cli.js",
    "audit:gemma4": "npm run build && node dist/src/gemma4-contract-cli.js",
    "audit:literal": "npm run build && node dist/src/literal-artifact-audit-cli.js",
    "inspect:gemma4-literal": "npm run build && node dist/src/gemma4-composite-literal-reader-cli.js",
    "compile:gemma4-real": "npm run build && node dist/src/gemma4-global-real-cli.js",
    "compare:gemma4-real-ui": "npm run build && node dist/src/gemma4-real-compare-server-cli.js",
    "calibrate:gemma4-real": "npm run build && node dist/src/gemma4-real-calibration-cli.js",
    "export:gemma4-real-ssa": "npm run build && node --max-old-space-size=6144 dist/src/gemma4-real-ssa-export-cli.js",
    "generate:gemma4-flat-formulas": "npm run build && node --max-old-space-size=6144 dist/src/gemma4-flat-formula-cli.js",
    "compose:gemma4-reverse": "npm run build && node --max-old-space-size=6144 dist/src/gemma4-parametric-reverse-cli.js",
    "bundle:gemma4-compiled": "npm run build && node dist/src/gemma4-compiled-bundle-cli.js",
    "index:gemma4-compiled": "npm run build && node --max-old-space-size=4096 dist/src/gemma4-literal-runtime-index-cli.js",
    "compile:gemma4-vector-lowering": "npm run build && node dist/src/gemma4-vectorized-real-lowering-cli.js",
    "replay:gemma4-paged-text": "npm run build && node dist/src/gemma4-paged-text-cli.js",
    "probe:gemma4-linear-reduction": "npm run build && node dist/src/gemma4-linear-reduction-probe-cli.js",
    "benchmark:native": "npm run build && node dist/src/benchmark-cli.js",
    "loop:start": "node scripts/agent-loop-runner.mjs start",
    "loop:status": "node scripts/agent-loop-runner.mjs status",
    "loop:stop": "node scripts/agent-loop-runner.mjs stop",
    "loop:supervisor": "node scripts/agent-loop-supervisor.mjs run",
    "loop:install-launchd": "node scripts/install-agent-loop-launchd.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "typescript": "^7.0.2"
  }
}
