{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "llm-inner autonomous agent loop configuration",
  "type": "object",
  "required": [
    "version",
    "enabled",
    "maxLoops",
    "maxConsecutiveFailures",
    "maxLoopDurationMinutes",
    "maxNoProgressMinutes",
    "cooldownSeconds",
    "transientLimitRetryInitialSeconds",
    "transientLimitRetryMaximumSeconds",
    "providers",
    "goalCommand",
    "missionGoal",
    "handoffDirectory",
    "processingDirectory",
    "rejectedDirectory",
    "runsDirectory",
    "stateFile",
    "lockFile",
    "stopFile",
    "promptFile",
    "handoffPattern",
    "requireCleanGitBeforeNextLoop",
    "requireNewCommitPerLoop",
    "requireHandoffValidation",
    "validationCommands",
    "missionGates"
  ],
  "properties": {
    "version": { "const": 1 },
    "enabled": { "type": "boolean" },
    "maxLoops": { "type": "integer", "minimum": 1 },
    "maxConsecutiveFailures": { "type": "integer", "minimum": 1 },
    "maxLoopDurationMinutes": { "type": "integer", "minimum": 1 },
    "maxNoProgressMinutes": { "type": "integer", "minimum": 1 },
    "cooldownSeconds": { "type": "integer", "minimum": 0 },
    "transientLimitRetryInitialSeconds": { "type": "integer", "minimum": 1 },
    "transientLimitRetryMaximumSeconds": { "type": "integer", "minimum": 1 },
    "providers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "kind", "command", "model"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "kind": { "enum": ["codex", "opencode", "kiro", "cursor"] },
          "command": { "type": "string", "minLength": 1 },
          "model": { "type": "string", "minLength": 1 },
          "reasoningEffort": { "enum": ["low", "medium", "high"] },
          "variant": { "type": "string", "minLength": 1 },
          "environment": {
            "type": "object",
            "additionalProperties": { "type": "string" }
          }
        },
        "additionalProperties": false
      }
    },
    "goalCommand": { "const": "/goal" },
    "missionGoal": { "type": "string", "minLength": 1 },
    "handoffDirectory": { "type": "string", "minLength": 1 },
    "processingDirectory": { "type": "string", "minLength": 1 },
    "rejectedDirectory": { "type": "string", "minLength": 1 },
    "runsDirectory": { "type": "string", "minLength": 1 },
    "stateFile": { "type": "string", "minLength": 1 },
    "lockFile": { "type": "string", "minLength": 1 },
    "stopFile": { "type": "string", "minLength": 1 },
    "promptFile": { "type": "string", "minLength": 1 },
    "handoffPattern": { "type": "string", "minLength": 1 },
    "requireCleanGitBeforeNextLoop": { "type": "boolean" },
    "requireNewCommitPerLoop": { "type": "boolean" },
    "requireHandoffValidation": { "type": "boolean" },
    "validationCommands": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "missionGates": { "type": "array" }
  },
  "additionalProperties": true
}
